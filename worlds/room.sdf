<?xml version="1.0"?>
<!-- A small 4 x 3 m room with a divider wall and two obstacles. -->
<sdf version="1.9">
  <world name="room">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_north">
      <static>true</static>
      <pose>0 1.5 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>4.0 0.05 0.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>4.0 0.05 0.4</size></box></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -1.5 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>4.0 0.05 0.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>4.0 0.05 0.4</size></box></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>2.0 0 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.05 3.0 0.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.05 3.0 0.4</size></box></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-2.0 0 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.05 3.0 0.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.05 3.0 0.4</size></box></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="divider">
      <static>true</static>
      <pose>0.6 0.65 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.05 1.7 0.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.05 1.7 0.4</size></box></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="box_crate">
      <static>true</static>
      <pose>-1.1 0.8 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.4 0.3 0.3</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.4 0.3 0.3</size></box></geometry>
          <material><ambient>0.55 0.38 0.22 1</ambient><diffuse>0.55 0.38 0.22 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="box_low">
      <static>true</static>
      <pose>1.3 -0.8 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.3 0.3 0.1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.3 0.3 0.1</size></box></geometry>
          <material><ambient>0.55 0.38 0.22 1</ambient><diffuse>0.55 0.38 0.22 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
