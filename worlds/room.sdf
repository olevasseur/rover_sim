<?xml version="1.0"?>
<!-- A 5 x 4 m room for driving and mapping: a divider wall, an angled wall,
     a pillar, a crate, a round bin and a table. Everything the lidar should
     see reaches above its scan plane (about 22 cm); the table top is above
     it, so only the four legs show up in the scan. Uneven features keep
     the scan matcher from confusing one part of the room with another. -->
<sdf version="1.9">
  <world name="room">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <!-- Renders the GPU lidar. -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_north">
      <static>true</static>
      <pose>0 2.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>5.05 0.05 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>5.05 0.05 0.5</size></box></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -2.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>5.05 0.05 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>5.05 0.05 0.5</size></box></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>2.5 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.05 4.0 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.05 4.0 0.5</size></box></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-2.5 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.05 4.0 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.05 4.0 0.5</size></box></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="divider">
      <static>true</static>
      <pose>0.5 1.15 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.05 1.7 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.05 1.7 0.5</size></box></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="angled_wall">
      <static>true</static>
      <pose>1.6 -1.0 0.25 0 0 0.5236</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.8 0.05 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.8 0.05 0.5</size></box></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="pillar">
      <static>true</static>
      <pose>-0.4 0.7 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 0.2 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 0.2 0.5</size></box></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="crate">
      <static>true</static>
      <pose>-1.6 1.4 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.4 0.3 0.3</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.4 0.3 0.3</size></box></geometry>
          <material><ambient>0.55 0.38 0.22 1</ambient><diffuse>0.55 0.38 0.22 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="bin">
      <static>true</static>
      <pose>1.6 1.0 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.15</radius><length>0.4</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.15</radius><length>0.4</length></cylinder></geometry>
          <material><ambient>0.25 0.4 0.6 1</ambient><diffuse>0.25 0.4 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="table_leg_0">
      <static>true</static>
      <pose>-1.3 -1.4 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.025</radius><length>0.7</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.025</radius><length>0.7</length></cylinder></geometry>
          <material><ambient>0.55 0.38 0.22 1</ambient><diffuse>0.55 0.38 0.22 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="table_leg_1">
      <static>true</static>
      <pose>-0.7 -1.4 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.025</radius><length>0.7</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.025</radius><length>0.7</length></cylinder></geometry>
          <material><ambient>0.55 0.38 0.22 1</ambient><diffuse>0.55 0.38 0.22 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="table_leg_2">
      <static>true</static>
      <pose>-1.3 -1.0 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.025</radius><length>0.7</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.025</radius><length>0.7</length></cylinder></geometry>
          <material><ambient>0.55 0.38 0.22 1</ambient><diffuse>0.55 0.38 0.22 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="table_leg_3">
      <static>true</static>
      <pose>-0.7 -1.0 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.025</radius><length>0.7</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.025</radius><length>0.7</length></cylinder></geometry>
          <material><ambient>0.55 0.38 0.22 1</ambient><diffuse>0.55 0.38 0.22 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="table_top">
      <static>true</static>
      <pose>-1.0 -1.2 0.71 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.7 0.5 0.02</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.7 0.5 0.02</size></box></geometry>
          <material><ambient>0.55 0.38 0.22 1</ambient><diffuse>0.55 0.38 0.22 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
