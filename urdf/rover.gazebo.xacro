<?xml version="1.0"?>
<!-- Gazebo-only parts of the rover: ros2_control hardware, the plugin that
     runs the controllers inside Gazebo, and contact friction. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- 100 RPM gearmotor at the wheel: 100 * 2 * pi / 60 = 10.5 rad/s. -->
  <xacro:property name="wheel_max_velocity" value="10.5"/>

  <ros2_control name="rover_gazebo" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <xacro:macro name="wheel_interfaces" params="joint">
      <joint name="${joint}">
        <command_interface name="velocity">
          <param name="min">${-wheel_max_velocity}</param>
          <param name="max">${wheel_max_velocity}</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </xacro:macro>
    <xacro:wheel_interfaces joint="left_wheel_joint"/>
    <xacro:wheel_interfaces joint="right_wheel_joint"/>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find rover_sim)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <!-- Rubber-like grip on the drive wheels. -->
  <xacro:macro name="wheel_friction" params="link">
    <gazebo reference="${link}">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
  </xacro:macro>
  <xacro:wheel_friction link="left_wheel_link"/>
  <xacro:wheel_friction link="right_wheel_link"/>

  <!-- The caster swivels and rolls freely, so its sphere is nearly
       frictionless. Keep it a separate link so the friction applies. -->
  <gazebo reference="caster_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <gazebo reference="caster_link">
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
  </gazebo>

</robot>
