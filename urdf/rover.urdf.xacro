<?xml version="1.0"?>
<!--
  Differential-drive rover: two driven wheels and a rear swivel caster.

  Frames follow REP 103/105: X forward, Y left, Z up.
  base_footprint is on the floor, midway between the two wheel contact points.
  base_link is directly above it, on the drive-wheel axle.

  All dimensions are in meters and kilograms. The CAD is drawn in millimeters,
  so meshes are scaled by 0.001. Masses and sensor dimensions are estimates,
  typical or datasheet values until they are weighed or measured.
-->
<robot name="rover" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- true when spawned in Gazebo: adds ros2_control and physics settings. -->
  <xacro:arg name="use_gazebo" default="false"/>

  <xacro:property name="PI" value="3.14159265358979"/>
  <xacro:property name="mm" value="0.001"/>
  <xacro:property name="mesh_scale" value="0.001 0.001 0.001"/>
  <xacro:property name="mesh_dir" value="package://rover_sim/meshes"/>

  <!-- ===================================================== drive wheels -->
  <xacro:property name="wheel_radius" value="${32.5 * mm}"/>     <!-- 61 mm rim + 3.5 mm TPU tyre -->
  <xacro:property name="wheel_width" value="${20.0 * mm}"/>
  <xacro:property name="wheel_separation" value="${214.6 * mm}"/> <!-- track width, centre to centre -->
  <xacro:property name="wheel_x" value="0.0"/>
  <!-- The wheel mesh's inner face sits 10 mm inboard of the wheel centre;
       the tyre mesh's inner face sits 7.8 mm inboard. -->
  <xacro:property name="wheel_mesh_offset" value="${10.0 * mm}"/>
  <xacro:property name="tyre_mesh_offset" value="${7.8 * mm}"/>

  <!-- base_link is on the axle, so it sits one wheel radius above the floor. -->
  <xacro:property name="base_z" value="${wheel_radius}"/>

  <!-- ========================================================== chassis -->
  <!-- Positions below are in the base_footprint frame (floor = 0) unless
       the name ends in _bl (base_link frame). -->
  <xacro:property name="deck_x_min" value="${-140.0 * mm}"/>
  <xacro:property name="deck_x_max" value="${55.0 * mm}"/>
  <xacro:property name="deck_width" value="${186.0 * mm}"/>
  <xacro:property name="deck_t" value="${4.0 * mm}"/>
  <xacro:property name="deck_bottom_z" value="${58.0 * mm}"/>
  <xacro:property name="deck_length" value="${deck_x_max - deck_x_min}"/>
  <xacro:property name="deck_cx" value="${(deck_x_max + deck_x_min) / 2}"/>

  <!-- Electronics deck. Its posts carry the compute deck above it. -->
  <xacro:property name="upper_x_min" value="${-100.0 * mm}"/>
  <xacro:property name="upper_x_max" value="${50.0 * mm}"/>
  <xacro:property name="upper_y_min" value="${-80.0 * mm}"/>
  <xacro:property name="upper_y_max" value="${100.0 * mm}"/>
  <xacro:property name="upper_t" value="${3.0 * mm}"/>
  <xacro:property name="upper_bottom_z" value="${114.0 * mm}"/>
  <xacro:property name="upper_length" value="${upper_x_max - upper_x_min}"/>
  <xacro:property name="upper_width" value="${upper_y_max - upper_y_min}"/>
  <xacro:property name="upper_cx" value="${(upper_x_max + upper_x_min) / 2}"/>
  <xacro:property name="upper_cy" value="${(upper_y_max + upper_y_min) / 2}"/>
  <xacro:property name="upper_top_z" value="${upper_bottom_z + upper_t}"/>
  <!-- The amp holder's dial wall stands 2 mm past the +Y edge, so the mesh
       spans Y -80..102 and is centred at 11 mm, not on the plate. -->
  <xacro:property name="upper_mesh_cy" value="${11.0 * mm}"/>

  <!-- Compute deck: the Pi hangs under it, the speaker grille is its front
       wall and the lidar mount sits on top. Collision covers the plate only. -->
  <xacro:property name="compute_x_min" value="${-100.0 * mm}"/>
  <xacro:property name="compute_x_max" value="${61.0 * mm}"/>
  <xacro:property name="compute_width" value="${72.0 * mm}"/>
  <xacro:property name="compute_t" value="${4.0 * mm}"/>
  <xacro:property name="compute_bottom_z" value="${170.0 * mm}"/>
  <xacro:property name="compute_top_z" value="${compute_bottom_z + compute_t}"/>
  <xacro:property name="compute_cx" value="${(compute_x_max + compute_x_min) / 2}"/>
  <!-- The compute deck mesh is centred on its full outline, grille included. -->
  <xacro:property name="compute_mesh_x" value="${-19.5 * mm}"/>

  <!-- Front bumper arc, approximated by its bounding box. -->
  <xacro:property name="bumper_x_min" value="${35.0 * mm}"/>
  <xacro:property name="bumper_x_max" value="${63.0 * mm}"/>
  <xacro:property name="bumper_width" value="${140.0 * mm}"/>
  <xacro:property name="bumper_z_min" value="${26.0 * mm}"/>
  <xacro:property name="bumper_z_max" value="${58.0 * mm}"/>

  <!-- Gearmotors (25 mm gearbox), body running inboard from the mount face. -->
  <xacro:property name="motor_radius" value="${12.5 * mm}"/>
  <xacro:property name="motor_y_inner" value="${2.0 * mm}"/>
  <xacro:property name="motor_y_outer" value="${83.8 * mm}"/>
  <xacro:property name="motor_z" value="${39.5 * mm}"/>
  <xacro:property name="motor_length" value="${motor_y_outer - motor_y_inner}"/>
  <!-- Motor cradle mesh origin, per side. -->
  <xacro:property name="cradle_y" value="${87.8 * mm}"/>
  <xacro:property name="cradle_z" value="${40.875 * mm}"/>

  <!-- Battery pack envelope (X x Y x Z) and centre. -->
  <xacro:property name="battery_size_x" value="${70.0 * mm}"/>
  <xacro:property name="battery_size_y" value="${90.0 * mm}"/>
  <xacro:property name="battery_size_z" value="${45.0 * mm}"/>
  <xacro:property name="battery_x" value="${-52.5 * mm}"/>
  <xacro:property name="battery_z" value="${88.5 * mm}"/>

  <!-- Raspberry Pi 3B+, hanging under the compute deck, components down.
       The box is the board plus the parts below it. -->
  <xacro:property name="pi_x_min" value="${-89.0 * mm}"/>
  <xacro:property name="pi_x_max" value="${-4.0 * mm}"/>
  <xacro:property name="pi_width" value="${56.0 * mm}"/>
  <xacro:property name="pi_z_min" value="${145.6 * mm}"/>
  <xacro:property name="pi_z_max" value="${164.0 * mm}"/>

  <!-- Speaker behind the front grille, facing forward. -->
  <xacro:property name="speaker_x_min" value="${41.0 * mm}"/>
  <xacro:property name="speaker_x_max" value="${57.5 * mm}"/>
  <xacro:property name="speaker_width" value="${76.0 * mm}"/>
  <xacro:property name="speaker_z_min" value="${132.0 * mm}"/>
  <xacro:property name="speaker_z_max" value="${166.0 * mm}"/>

  <!-- =========================================================== caster -->
  <!-- Swivel caster, 38 mm tall from the floor to the top of its plate,
       modelled as a fixed sphere under the swivel axis. The wheel diameter
       is an estimate until measured; the real contact point trails the
       swivel axis by its offset. -->
  <xacro:property name="caster_x" value="${-100.0 * mm}"/>
  <xacro:property name="caster_radius" value="${12.5 * mm}"/>   <!-- 25 mm wheel, estimate -->
  <xacro:property name="caster_height" value="${38.0 * mm}"/>
  <xacro:property name="caster_spacer_h" value="${20.0 * mm}"/>
  <!-- The spacer sits on the caster plate; its mesh origin is its bottom. -->
  <xacro:property name="caster_spacer_z" value="${caster_height}"/>

  <!-- ============================================================ lidar -->
  <!-- RPLIDAR A1M8. Datasheet values, not measured yet. The lidar is mounted
       with its motor tail pointing forward. The body is drawn as a simple
       envelope: a base plate under a round scanning head. -->
  <xacro:property name="lidar_x" value="${-25.0 * mm}"/>          <!-- spin axis -->
  <xacro:property name="lidar_z" value="${223.0 * mm}"/>          <!-- scan plane -->
  <xacro:property name="lidar_mount_x" value="${-18.375 * mm}"/>  <!-- mount mesh origin -->
  <xacro:property name="lidar_base_z" value="${202.0 * mm}"/>     <!-- underside of the lidar base -->
  <xacro:property name="lidar_base_x_min" value="${-60.24 * mm}"/>
  <xacro:property name="lidar_base_length" value="${96.74 * mm}"/>
  <xacro:property name="lidar_base_width" value="${70.28 * mm}"/>
  <xacro:property name="lidar_base_t" value="${8.0 * mm}"/>       <!-- estimate -->
  <xacro:property name="lidar_head_radius" value="${35.0 * mm}"/>
  <xacro:property name="lidar_top_z" value="${234.5 * mm}"/>

  <!-- ============================================================ camera -->
  <!-- Space reserved between the decks; no camera chosen yet. -->
  <xacro:property name="camera_x" value="${55.0 * mm}"/>
  <xacro:property name="camera_z" value="${83.0 * mm}"/>

  <!-- ============================================================ masses -->
  <!-- Printed parts: slicer estimates (PLA, 15 % infill), or STL volume
       x 0.80 g/cm3 for parts not sliced yet ("volume estimate"). -->
  <xacro:property name="lower_deck_mass" value="0.1246"/>
  <xacro:property name="upper_deck_mass" value="0.1048"/>      <!-- volume estimate, with the amp stop wall -->
  <xacro:property name="compute_deck_mass" value="0.0476"/>    <!-- volume estimate -->
  <xacro:property name="lidar_mount_mass" value="0.0173"/>     <!-- volume estimate -->
  <xacro:property name="cradle_mass" value="0.0127"/>          <!-- each -->
  <xacro:property name="caster_spacer_mass" value="0.0104"/>   <!-- volume estimate -->
  <xacro:property name="bumper_mass" value="0.0277"/>
  <xacro:property name="wheel_mass" value="${0.0179 + 0.0147}"/> <!-- PLA rim + TPU tyre, volume estimates -->
  <!-- Purchased parts: "weighed" values are kitchen-scale readings (+/- 1 g);
       the rest are datasheet or typical values until weighed. -->
  <xacro:property name="motor_mass" value="0.100"/>            <!-- each, spec estimate (not arrived) -->
  <xacro:property name="coupler_mass" value="0.012"/>          <!-- each, with screws -->
  <xacro:property name="esp32_mass" value="0.041"/>            <!-- with breakout board, weighed -->
  <xacro:property name="driver_mass" value="0.006"/>           <!-- each motor driver, weighed -->
  <xacro:property name="buck_mass" value="0.025"/>
  <xacro:property name="power_parts_mass" value="0.030"/>      <!-- connectors, capacitor, jack -->
  <xacro:property name="pi_mass" value="0.050"/>               <!-- bare board, weighed -->
  <xacro:property name="speaker_mass" value="0.025"/>          <!-- weighed -->
  <xacro:property name="amp_mass" value="0.005"/>              <!-- PAM8403 board, weighed -->
  <xacro:property name="lidar_mass" value="0.170"/>
  <xacro:property name="lidar_usb_mass" value="0.015"/>        <!-- USB adapter + cable, assumed -->
  <xacro:property name="wiring_mass" value="0.060"/>           <!-- wires + fasteners, assumed -->
  <xacro:property name="battery_mass" value="0.350"/>          <!-- assumed -->
  <xacro:property name="caster_mass" value="0.030"/>

  <!-- base_link carries everything except the wheels and the caster.
       Each row is (mass, x, y, z) of one item's centre of mass, in the
       base_footprint frame. Its inertia is a solid box over the chassis
       envelope, centred on the combined centre of mass. -->
  <xacro:property name="base_items" value="${[
      (lower_deck_mass, deck_cx, 0, deck_bottom_z + deck_t / 2),
      (upper_deck_mass, upper_cx, upper_cy / 2, upper_bottom_z + 8 * mm),
      (compute_deck_mass, compute_cx + 10 * mm, 0, compute_top_z - 8 * mm),
      (lidar_mount_mass, lidar_mount_x, 0, compute_top_z + 14 * mm),
      (cradle_mass, 0, cradle_y, cradle_z),
      (cradle_mass, 0, -cradle_y, cradle_z),
      (caster_spacer_mass, caster_x, 0, caster_spacer_z + caster_spacer_h / 2),
      (bumper_mass, (bumper_x_min + bumper_x_max) / 2, 0, (bumper_z_min + bumper_z_max) / 2),
      (2 * motor_mass, 0, 0, motor_z),
      (2 * coupler_mass, 0, 0, base_z),
      (esp32_mass, -45 * mm, 66 * mm, 137.5 * mm),
      (2 * driver_mass, 26 * mm, 0, 128 * mm),
      (buck_mass, -54 * mm, -16 * mm, 129.5 * mm),
      (power_parts_mass, -40 * mm, -50 * mm, upper_top_z + 6 * mm),
      (pi_mass, (pi_x_min + pi_x_max) / 2, 0, 157 * mm),
      (speaker_mass, (speaker_x_min + speaker_x_max) / 2, 0, (speaker_z_min + speaker_z_max) / 2),
      (amp_mass, 15.75 * mm, 81.5 * mm, 128.5 * mm),
      (lidar_mass, -17 * mm, 0, 207 * mm),
      (lidar_usb_mass, -30 * mm, 0, 183 * mm),
      (wiring_mass, -20 * mm, 0, 100 * mm),
      (battery_mass, battery_x, 0, battery_z)]}"/>
  <xacro:property name="base_mass" value="${python.sum(i[0] for i in base_items)}"/>
  <xacro:property name="base_com_x" value="${python.sum(i[0] * i[1] for i in base_items) / base_mass}"/>
  <xacro:property name="base_com_y" value="${python.sum(i[0] * i[2] for i in base_items) / base_mass}"/>
  <xacro:property name="base_com_z" value="${python.sum(i[0] * i[3] for i in base_items) / base_mass}"/>
  <xacro:property name="base_box_x" value="${bumper_x_max - deck_x_min}"/>
  <xacro:property name="base_box_y" value="${deck_width}"/>
  <xacro:property name="base_box_z" value="${lidar_top_z - (motor_z - motor_radius)}"/>

  <!-- ======================================================== materials -->
  <material name="pla">
    <color rgba="0.85 0.72 0.50 1.0"/>
  </material>
  <material name="tyre">
    <color rgba="0.15 0.15 0.15 1.0"/>
  </material>
  <material name="metal">
    <color rgba="0.60 0.62 0.66 1.0"/>
  </material>
  <material name="board">
    <color rgba="0.10 0.45 0.20 1.0"/>
  </material>
  <material name="dark">
    <color rgba="0.20 0.20 0.22 1.0"/>
  </material>
  <material name="battery">
    <color rgba="0.20 0.55 0.30 0.8"/>
  </material>

  <!-- ===================================================== inertia macros -->
  <xacro:macro name="box_inertial" params="mass x y z *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia ixx="${mass * (y * y + z * z) / 12}" ixy="0" ixz="0"
               iyy="${mass * (x * x + z * z) / 12}" iyz="0"
               izz="${mass * (x * x + y * y) / 12}"/>
    </inertial>
  </xacro:macro>

  <!-- Solid cylinder whose axis is the link's Y axis. -->
  <xacro:macro name="cylinder_y_inertial" params="mass radius length">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia ixx="${mass * (3 * radius * radius + length * length) / 12}" ixy="0" ixz="0"
               iyy="${mass * radius * radius / 2}" iyz="0"
               izz="${mass * (3 * radius * radius + length * length) / 12}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertial" params="mass radius">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia ixx="${2 * mass * radius * radius / 5}" ixy="0" ixz="0"
               iyy="${2 * mass * radius * radius / 5}" iyz="0"
               izz="${2 * mass * radius * radius / 5}"/>
    </inertial>
  </xacro:macro>

  <!-- ===================================================== base links -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_z}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <!-- Meshes are exported centred in XY with their lowest point at Z = 0;
         each origin below puts the part back where it sits on the rover. -->
    <visual>
      <origin xyz="${deck_cx} 0 ${deck_bottom_z - base_z}" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_dir}/lower_deck.stl" scale="${mesh_scale}"/>
      </geometry>
      <material name="pla"/>
    </visual>
    <visual>
      <origin xyz="${upper_cx} ${upper_mesh_cy} ${upper_bottom_z - base_z}" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_dir}/upper_deck.stl" scale="${mesh_scale}"/>
      </geometry>
      <material name="pla"/>
    </visual>
    <visual>
      <origin xyz="${compute_mesh_x} 0 ${compute_top_z - base_z}" rpy="${PI} 0 0"/>
      <geometry>
        <mesh filename="${mesh_dir}/compute_deck.stl" scale="${mesh_scale}"/>
      </geometry>
      <material name="pla"/>
    </visual>
    <visual>
      <origin xyz="${lidar_mount_x} 0 ${compute_top_z - base_z}" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_dir}/lidar_mount.stl" scale="${mesh_scale}"/>
      </geometry>
      <material name="pla"/>
    </visual>
    <!-- The bumper, cradles and compute deck are exported in their print
         orientation. -->
    <visual>
      <origin xyz="${(bumper_x_min + bumper_x_max) / 2} 0 ${bumper_z_max - base_z}" rpy="${PI} 0 0"/>
      <geometry>
        <mesh filename="${mesh_dir}/front_bumper.stl" scale="${mesh_scale}"/>
      </geometry>
      <material name="pla"/>
    </visual>
    <visual>
      <origin xyz="${caster_x} 0 ${caster_spacer_z - base_z}" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_dir}/caster_spacer.stl" scale="${mesh_scale}"/>
      </geometry>
      <material name="pla"/>
    </visual>
    <visual>
      <origin xyz="0 ${cradle_y} ${cradle_z - base_z}" rpy="${PI / 2} 0 0"/>
      <geometry>
        <mesh filename="${mesh_dir}/motor_cradle.stl" scale="${mesh_scale}"/>
      </geometry>
      <material name="pla"/>
    </visual>
    <visual>
      <origin xyz="0 ${-cradle_y} ${cradle_z - base_z}" rpy="${PI / 2} 0 ${PI}"/>
      <geometry>
        <mesh filename="${mesh_dir}/motor_cradle.stl" scale="${mesh_scale}"/>
      </geometry>
      <material name="pla"/>
    </visual>
    <!-- Purchased parts have no mesh; drawn as primitives. -->
    <visual>
      <origin xyz="0 ${(motor_y_inner + motor_y_outer) / 2} ${motor_z - base_z}" rpy="${PI / 2} 0 0"/>
      <geometry>
        <cylinder radius="${motor_radius}" length="${motor_length}"/>
      </geometry>
      <material name="metal"/>
    </visual>
    <visual>
      <origin xyz="0 ${-(motor_y_inner + motor_y_outer) / 2} ${motor_z - base_z}" rpy="${PI / 2} 0 0"/>
      <geometry>
        <cylinder radius="${motor_radius}" length="${motor_length}"/>
      </geometry>
      <material name="metal"/>
    </visual>
    <visual>
      <origin xyz="${battery_x} 0 ${battery_z - base_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${battery_size_x} ${battery_size_y} ${battery_size_z}"/>
      </geometry>
      <material name="battery"/>
    </visual>
    <visual>
      <origin xyz="${(pi_x_min + pi_x_max) / 2} 0 ${(pi_z_min + pi_z_max) / 2 - base_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${pi_x_max - pi_x_min} ${pi_width} ${pi_z_max - pi_z_min}"/>
      </geometry>
      <material name="board"/>
    </visual>
    <visual>
      <origin xyz="${(speaker_x_min + speaker_x_max) / 2} 0 ${(speaker_z_min + speaker_z_max) / 2 - base_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${speaker_x_max - speaker_x_min} ${speaker_width} ${speaker_z_max - speaker_z_min}"/>
      </geometry>
      <material name="dark"/>
    </visual>
    <visual>
      <origin xyz="${lidar_base_x_min + lidar_base_length / 2} 0 ${lidar_base_z + lidar_base_t / 2 - base_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${lidar_base_length} ${lidar_base_width} ${lidar_base_t}"/>
      </geometry>
      <material name="dark"/>
    </visual>
    <visual>
      <origin xyz="${lidar_x} 0 ${(lidar_base_z + lidar_base_t + lidar_top_z) / 2 - base_z}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_head_radius}" length="${lidar_top_z - lidar_base_z - lidar_base_t}"/>
      </geometry>
      <material name="dark"/>
    </visual>

    <collision>
      <origin xyz="${deck_cx} 0 ${deck_bottom_z + deck_t / 2 - base_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${deck_length} ${deck_width} ${deck_t}"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="${upper_cx} ${upper_cy} ${upper_bottom_z + upper_t / 2 - base_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${upper_length} ${upper_width} ${upper_t}"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="${compute_cx} 0 ${compute_bottom_z + compute_t / 2 - base_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${compute_x_max - compute_x_min} ${compute_width} ${compute_t}"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="${(speaker_x_min + speaker_x_max) / 2} 0 ${(speaker_z_min + speaker_z_max) / 2 - base_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${speaker_x_max - speaker_x_min} ${speaker_width} ${speaker_z_max - speaker_z_min}"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="${lidar_x} 0 ${(lidar_base_z + lidar_top_z) / 2 - base_z}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_head_radius}" length="${lidar_top_z - lidar_base_z}"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="${(bumper_x_min + bumper_x_max) / 2} 0 ${(bumper_z_min + bumper_z_max) / 2 - base_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${bumper_x_max - bumper_x_min} ${bumper_width} ${bumper_z_max - bumper_z_min}"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0 0 ${motor_z - base_z}" rpy="${PI / 2} 0 0"/>
      <geometry>
        <cylinder radius="${motor_radius}" length="${2 * motor_y_outer}"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="${battery_x} 0 ${battery_z - base_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${battery_size_x} ${battery_size_y} ${battery_size_z}"/>
      </geometry>
    </collision>

    <xacro:box_inertial mass="${base_mass}" x="${base_box_x}" y="${base_box_y}" z="${base_box_z}">
      <origin xyz="${base_com_x} ${base_com_y} ${base_com_z - base_z}" rpy="0 0 0"/>
    </xacro:box_inertial>
  </link>

  <!-- ============================================================ wheels -->
  <!-- side: 1 = left (+Y), -1 = right (-Y). Both joints spin about +Y, so a
       positive velocity drives the rover forward on both sides. -->
  <xacro:macro name="drive_wheel" params="prefix side">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 ${-side * wheel_mesh_offset} 0" rpy="${-PI / 2} 0 ${(1 - side) * PI / 2}"/>
        <geometry>
          <mesh filename="${mesh_dir}/drive_wheel.stl" scale="${mesh_scale}"/>
        </geometry>
        <material name="pla"/>
      </visual>
      <visual>
        <origin xyz="0 ${-side * tyre_mesh_offset} 0" rpy="${-PI / 2} 0 ${(1 - side) * PI / 2}"/>
        <geometry>
          <mesh filename="${mesh_dir}/tyre.stl" scale="${mesh_scale}"/>
        </geometry>
        <material name="tyre"/>
      </visual>
      <!-- In Gazebo a cylinder touches the floor along its edges, which makes
           the rover turn about 9 % more than the wheel odometry reports. A
           sphere touches at a single point in the wheel's centre plane, so
           the simulated track width matches wheel_separation. -->
      <collision>
        <xacro:if value="$(arg use_gazebo)">
          <geometry>
            <sphere radius="${wheel_radius}"/>
          </geometry>
        </xacro:if>
        <xacro:unless value="$(arg use_gazebo)">
          <origin xyz="0 0 0" rpy="${PI / 2} 0 0"/>
          <geometry>
            <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
          </geometry>
        </xacro:unless>
      </collision>
      <xacro:cylinder_y_inertial mass="${wheel_mass}" radius="${wheel_radius}" length="${wheel_width}"/>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${wheel_x} ${side * wheel_separation / 2} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:drive_wheel prefix="left" side="1"/>
  <xacro:drive_wheel prefix="right" side="-1"/>

  <!-- ============================================================ caster -->
  <link name="caster_link">
    <visual>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <material name="metal"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>
    <xacro:sphere_inertial mass="${caster_mass}" radius="${caster_radius}"/>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="${caster_x} 0 ${caster_radius - base_z}" rpy="0 0 0"/>
  </joint>

  <!-- ==================================================== sensor frames -->
  <!-- lidar_link sits on the scan centre: spin axis, at scan-plane height.
       It is aligned with base_link (X forward). The A1M8 is mounted with its
       motor tail forward, so check which way the driver's 0 degree points
       before using real scans, and rotate this frame or set the driver's
       flip option to match. camera_link is a placeholder for the lens. -->
  <link name="lidar_link"/>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="${lidar_x} 0 ${lidar_z - base_z}" rpy="0 0 0"/>
  </joint>

  <link name="camera_link"/>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${camera_x} 0 ${camera_z - base_z}" rpy="0 0 0"/>
  </joint>

  <xacro:if value="$(arg use_gazebo)">
    <xacro:include filename="rover.gazebo.xacro"/>
  </xacro:if>

</robot>
